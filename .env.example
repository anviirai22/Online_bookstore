NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/online_bookstore
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/online_bookstore_test
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=2h
COOKIE_NAME=bookstore_access
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PAYMENT_ADAPTER=sandbox
PAYMENT_SANDBOX_MODE=success
PAYMENT_PENDING_TIMEOUT_MINUTES=30
SHIPPING_CENTS=499
CANCELLATION_WINDOW_HOURS=24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-local-password
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=change-this-local-password
VITE_API_URL=/api
